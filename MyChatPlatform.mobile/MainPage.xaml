        <Grid Grid.Row="2" ColumnDefinitions="*,Auto"><Entry x:Name="MessageEntry" Placeholder="اكتب..." /><Button Grid.Column="1" Text="ارسال" Clicked="OnSendClicked" /></Grid>
    </Grid>
</ContentPage>
