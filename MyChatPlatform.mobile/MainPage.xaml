<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyChatPlatformk.Mobile.MainPage">
    <Grid RowDefinitions="*, Auto">
        <!-- منطقة عرض الرسائل -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout x:Name="MessagesStack" Spacing="5" Padding="10" />
        </ScrollView>

        <!-- منطقة الإدخال والإرسال -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Padding="10">
            <Entry x:Name="MessageEntry" Placeholder="اكتب رسالتك..." />
            <Button Grid.Column="1" Text="إرسال" Clicked="OnSendClicked" />
        </Grid>
    </Grid>
</ContentPage>
